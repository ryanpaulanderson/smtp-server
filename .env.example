# Copy to .env.local only for manually configured local development.
# `pnpm test:integration` generates its own isolated fixtures and ignores this file.
# Keep real secrets out of Git and chat. In Vercel, set these on the project instead.
APP_ENV=production
SEND_ENABLED=false
MCP_RESOURCE_URL=https://emailmcp.ryanpaulanderson.com/mcp

# Copy exact values from the Descope MCP Auth resource's discovery document.
OAUTH_ISSUER_URL=
OAUTH_JWKS_URL=
OWNER_SUBJECT=
# Optional comma-separated HTTPS browser origins. Native clients need no Origin.
MCP_ALLOWED_ORIGINS=

# Same verified Proton custom-domain address for sender and recipient.
MAIL_FROM=
MAIL_TO=
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Armored PUBLIC key only. The fingerprint must be 40 or 64 hexadecimal characters.
# Next.js supports a quoted multiline value; no private key is needed or accepted.
PGP_PUBLIC_KEY=
PGP_FINGERPRINT=

# Runtime role: USAGE on email_mcp and SELECT/INSERT/UPDATE on send_attempts only.
# URL must use sslmode=verify-full. Do not use a database administrator here.
DATABASE_URL=

# JSON map of key IDs to independently generated base64url keys of at least 32 bytes.
# Retain historical entries for all existing operation records.
REQUEST_HMAC_KEYS=
REQUEST_HMAC_CURRENT_KEY=v1

# Local CLI only, never add migration credentials to the Vercel runtime project.
# Set DATABASE_ADMIN_URL or DATABASE_ADMIN_URL_FILE explicitly when migrating.
# Supported file alternatives: DATABASE_URL_FILE, PGP_PUBLIC_KEY_FILE,
# PGP_FINGERPRINT_FILE, SMTP_PASSWORD_FILE, REQUEST_HMAC_KEYS_FILE.
# A value and its _FILE alternative cannot both be set.
